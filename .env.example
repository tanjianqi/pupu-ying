# === 扑扑鹰 环境变量模板 ===
# 复制本文件为 .env 并填入真实凭证后使用（.env 已被 .gitignore 排除）
#
# 邮件服务：腾讯企业邮箱 SMTP
# 文档：https://exmail.qq.com/help  → 客户端设置
#   SMTP 服务器：smtp.exmail.qq.com
#   SSL 端口：465（推荐）
#   发件邮箱必须开启 SMTP 并生成「客户端专用密码」（非登录密码）

# SMTP 服务器地址（腾讯企业邮默认 smtp.exmail.qq.com）
SMTP_HOST=smtp.exmail.qq.com

# SMTP 端口（465=SSL，587=STARTTLS）
SMTP_PORT=465

# 是否使用 SSL（465 端口 true，587 端口 false）
SMTP_SECURE=true

# 发件邮箱（完整地址，如 system@ppypaper.com）
SMTP_USER=

# 客户端专用密码（在腾讯企业邮后台「邮箱设置 → 客户端专用密码」生成）
SMTP_PASS=

# 发件人显示名（出现在收件人邮件「发件人」字段）
SMTP_FROM_NAME=扑扑鹰官网咨询

# 收件邮箱（联系表单提交后，邮件发送到此邮箱）
MAIL_TO=geo@ppypaper.com

# === 反垃圾配置（v1.4.0 可选）===

# 联系表单速率限制：每 IP 每分钟最大提交次数（默认 3）
CONTACT_RATE_LIMIT_MAX=3

# reCAPTCHA 服务端密钥（可选，配置后启用 reCAPTCHA 人机验证）
# 申请：https://www.google.com/recaptcha/admin → 选择 v2 或 v3 → 填站点域名
# 留空则不启用 reCAPTCHA，仅靠蜜罐 + 速率限制防垃圾
RECAPTCHA_SECRET=

