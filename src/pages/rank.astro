---
// 页面: GEO 排名查询（rank）
// 职责: 提供关键词 + 平台查询表单，展示在主流 AI 搜索平台的排名表现
// 依赖: BaseLayout, /scripts/pages/rank.js, /src/data/rank-mock.json（mock 数据源）
// 状态: v0.7.0 演示版，结果来自硬编码 mock，后端 /api/rank 未接通
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout activeNav="rank" title="GEO排名查询 - 扑扑鹰" bodyClass="business-home">

    <section class="hero-section">
        <div class="hero-sf bg_cover" style="background-image: url(/assets/image/hero-bg1.jpg);">
            <div class="container">
                <div class="row">
                    <div class="col-xl-12">
                        <div class="hero-content text-center">
                            <h1 class="text-anm">GEO 排名查询</h1>
                            <h5 data-aos="fade-up" data-aos-duration="1600">输入关键词，查询在主流 <b class="highlight-bred">AI 搜索平台</b> 的排名表现</h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="rank-page-ss pt-100 pb-100">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="section-title style-one text-center mb-60" data-aos="fade-up" data-aos-duration="1000">
                        <span class="sub-heading"><i class="far fa-arrow-right"></i>排名查询</span>
                        <h2 class="text-anm">实时查询品牌关键词排名</h2>
                        <p>输入关键词与目标 AI 平台，查看品牌在该平台的<b class="highlight-number">可见度</b>与<b class="highlight-number-d">排名变化</b></p>
                    </div>
                </div>
            </div>

            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="contact-wrapper mb-50" data-aos="fade-up" data-aos-duration="1400">
                        <h3>排名查询</h3>
                        <p>输入关键词，选择目标 AI 平台，查看排名表现 *</p>
                        <!-- TODO(后端): 接通 /api/rank 接口后，删除 mock 引用与 demo-note -->
                        <form id="rank-form" class="contact-form rank-form" novalidate>
                            <div class="row">
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <input type="text" class="form_control" placeholder="请输入关键词，如 GEO优化" name="keyword" id="rank-keyword" required>
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="form-group">
                                        <select class="form_control" name="platform" id="rank-platform">
                                            <option value="全部">全部平台</option>
                                            <option value="豆包">豆包</option>
                                            <option value="DeepSeek">DeepSeek</option>
                                            <option value="文心一言">文心一言</option>
                                            <option value="通义千问">通义千问</option>
                                            <option value="Kimi">Kimi</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-lg-2">
                                    <div class="form-group">
                                        <button type="submit" class="theme-btn style-one w-100">查询 <i class="far fa-angle-double-right"></i></button>
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="form-group rank-form-tip" id="rank-form-tip" hidden>
                                        <p class="text-danger mb-0"><i class="far fa-exclamation-circle"></i> 请输入关键词后再查询</p>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="row justify-content-center" id="rank-result-wrapper" hidden>
                <div class="col-lg-10">
                    <div class="rank-result-box" data-aos="fade-up" data-aos-duration="1200">
                        <div class="section-title style-one mb-30">
                            <span class="sub-heading"><i class="far fa-arrow-right"></i>查询结果</span>
                            <h3 class="text-anm">排名表现一览</h3>
                        </div>
                        <p class="demo-note"><small>* 演示数据，后端接口未接通</small></p>
                        <div class="table-responsive">
                            <table class="table table-bordered rank-table">
                                <thead>
                                    <tr>
                                        <th>关键词</th>
                                        <th>平台</th>
                                        <th>排名</th>
                                        <th>链接</th>
                                        <th>变化</th>
                                    </tr>
                                </thead>
                                <tbody id="rank-result-body">
                                    <!-- 由 rank.js 渲染 -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="cta-sb bg_cover p-r z-1 pt-90 pb-40" style="background-image: url(/assets/image/cta-bg1.jpg);">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-xl-8">
                    <div class="section-content-box mb-50">
                        <div class="section-title text-white mb-55">
                            <h2 class="text-anm"><span class="font-200">需要GEO优化方案？</span> <br>
                                我们随时准备为您提供<br>
                                专业的AI搜索优化建议</h2>
                        </div>
                        <div class="cta-button" data-aos="fade-up" data-aos-duration="1200">
                            <a href="/contact" class="theme-btn style-one">免费咨询诊断<i class="far fa-angle-double-right"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script>import '../scripts/pages/rank.js';</script>
</BaseLayout>
