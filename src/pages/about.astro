---
// 页面: 关于扑扑鹰
// 职责: 公司介绍 —— hero横幅 + 公司简介 + 数据统计 + GEO说明 + 跑马灯 + 为什么要GEO + 客户logo墙 + CTA
// 依赖: BaseLayout, CTASection
// 来源: 从原 about.html 迁移 main 内容，路径/内链按规则替换
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
---
<BaseLayout activeNav="about" title="关于我们 - 扑扑鹰" bodyClass="business-home">

    <section class="page-hero-ss">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="page-content text-center">
                        <h1 class="page-title">关于扑扑鹰</h1>
                        <ul class="breadcrumb-link">
                            <li><a href="/">扑扑鹰GEO</a></li>
                            <li class="active">关于扑扑鹰</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="page-banner-ss pb-130">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="sasly-image-box">
                        <img src="/assets/picture/about11.jpg" alt="扑扑鹰">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="about-page-ss">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-12">
                    <div class="section-title mb-60">
                        <h2 class="text-anm"><span class="font-200">让优质品牌被AI看见</span> <br>湖北扑扑鹰科技 · 中国首家<br>专注GEO（生成式引擎优化）技术服务商</h2>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6">
                    <!--=== Section Content Box ===-->
                    <div class="section-content-box mb-40">
                        <div class="experience-box mb-60" data-aos="fade-up">
                            <div class="number">
                                8+
                            </div>
                            <div class="duration">
                                年团队行业深耕经验，<br> 服务客户超500+
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="section-content-box  mb-40">
                        <p class="mb-35" data-aos="fade-up">专业团队深入了解您的品牌目标和市场需求，制定针对性GEO策略，驱动品牌在AI搜索中的可见度与影响力。无论您是想提升品牌知名度还是获取更多精准流量。</p>
                        <div class="row">
                            <div class="col-sm-6" data-aos="fade-up">
                                <ul class="check-list style-one mb-50">
                                    <li><i class="fas fa-badge-check"></i>AI平台覆盖度检测</li>
                                    <li><i class="fas fa-badge-check"></i>竞品AI可见度对比报告</li>
                                    <li><i class="fas fa-badge-check"></i>知识图谱关联度诊断</li>
                                </ul>
                            </div>
                            <div class="col-sm-6" data-aos="fade-up">
                                <ul class="check-list style-one mb-50">
                                    <li><i class="fas fa-badge-check"></i>月度AI可见度报告</li>
                                    <li><i class="fas fa-badge-check"></i>权威性内容建设指导</li>
                                    <li><i class="fas fa-badge-check"></i>紧急响应与优化调整</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="counter-page-ss">
        <div class="container">
            <div class="row">
                <div class="col-lg-3 col-sm-6">
                    <div class="sasly-counter-item style-two mb-30" data-aos="fade-up" data-aos-duration="1000">
                        <div class="content">
                            <h2 class="number"><span class="count">500</span>+</h2>
                            <img src="/assets/picture/arrow.png" alt="Arrow">
                            <p>服务客户</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-sm-6">
                    <div class="sasly-counter-item style-two mb-30" data-aos="fade-up" data-aos-duration="1200">
                        <div class="content">
                            <h2 class="number"><span class="count">85</span>%</h2>
                            <img src="/assets/picture/arrow.png" alt="Arrow">
                            <p>平均可见度提升</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-sm-6">
                    <div class="sasly-counter-item style-two mb-30" data-aos="fade-up" data-aos-duration="1600">
                        <div class="content">
                            <h2 class="number"><span class="count">3亿</span>+</h2>
                            <img src="/assets/picture/arrow.png" alt="Arrow">
                            <p>品牌曝光量</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-sm-6">
                    <div class="sasly-counter-item style-two mb-30" data-aos="fade-up" data-aos-duration="1400">
                        <div class="content">
                            <h2 class="number"><span class="count">120</span>+</h2>
                            <img src="/assets/picture/arrow.png" alt="Arrow">
                            <p>覆盖行业</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="why-choose-sel pt-100 pb-80">
        <div class="choose-bg-left"></div>
        <div class="choose-bg-right bg_cover" style="background-image: url(/assets/image/choose-bg12.jpg);"></div>
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <!-- Section Content Box -->
                    <div class="section-content-box mb-50">
                        <div class="section-title text-white">
                            <span class="sub-heading">什么是GEO</span>
                            <h2 class="text-anm">生成式引擎优化</h2>
                            <p>Generative Engine Optimization</p>
                        </div>
                        <p data-aos="fade-up" data-aos-duration="1000">GEO是SEO在AI时代的进化形态。当用户从传统搜索引擎转向DeepSeek、豆包、元宝、文心一言等AI助手获取信息时，GEO帮助您的品牌在这些生成式AI平台中获得可见性和推荐，抢占AI搜索新入口。</p>
                        <a href="/rank" data-aos="fade-up" class="theme-btn style-one">立即检测品牌可见性<i class="far fa-angle-double-right"></i></a>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="section-content-box mb-30">
                        <div class="sasly-iconic-box style-seven mb-20" data-aos="fade-up" data-aos-duration="1000">
                            <div class="content">
                                <h4 class="title"><i class="far fa-tools"></i>系统稳定性保障</h4>
                                <p>多维度提供专业稳定性保障，多年技术积累，资深团队为您保驾护航，运维有保障，技术更放心</p>
                            </div>
                        </div>
                        <div class="sasly-iconic-box style-seven mb-20" data-aos="fade-up" data-aos-duration="1200">
                            <div class="content">
                                <h4 class="title"><i class="far fa-cog"></i>产品迭代速度快</h4>
                                <p>基于真实合规的服务原则，10年以上经验研发团队，深耕AI营销领域</p>
                            </div>
                        </div>
                        <div class="sasly-iconic-box style-seven mb-20" data-aos="fade-up" data-aos-duration="1400">
                            <div class="content">
                                <h4 class="title"><i class="far fa-book"></i>高效的沟通渠道</h4>
                                <p>全程顾问式服务，一对一专属顾问，为您提供高效的沟通渠道，全过程顾问式服务</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="animated-big-text pb-75">
        <div class="headline-wrap style-two">
            <span class="marquee-wrap">
                <span class="marquee-inner left">
                    <span class="marquee-item"><b>  扑扑鹰·专业领先的GEO优化服务商。</b></span>
                    <span class="marquee-item"><b>让你的品牌，成为AI的答案</b></span>
                </span>
                <span class="marquee-inner left">
                    <span class="marquee-item"><b>  扑扑鹰·专业领先的GEO优化服务商。</b></span>
                    <span class="marquee-item"><b>让你的品牌，成为AI的答案</b></span>
                </span>
            </span>
        </div>
    </section>

    <section class="what-we-ss">
        <div class="wrapper primary-bg pt-100 pb-100">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="section-title style-one text-white text-center mb-60" data-aos="fade-up" data-aos-duration="1500">
                            <span class="sub-heading"><i class="far fa-arrow-right"></i>为什么要做GEO优化</span>
                            <h4 class="text-anm"><span class="font-200">GEO是面向 AI 搜索引擎（如豆包、kimi、Deepseek、ChatGPT 等）的优化方式 助力品牌提升展示效果与可见度，借助 AI 即时生成结构化、多模态的回答</span></h4>
                        </div>
                    </div>
                </div>
                <div class="row justify-content-center">
                    <div class="col-lg-4 col-md-6 col-sm-12">
                        <div class="sasly-info-box style-one mb-30" data-aos="fade-up">
                            <div class="content">
                                <div class="number">01</div>
                                <h4 class="title">大幅提升品牌形象</h4>
                                <p>&nbsp;&nbsp;&nbsp;&nbsp;让你的品牌成为AI的答案，提升品牌权威性和可信度，通过GEO，企业可以确保其品牌内容被AI准确理解和引用，从而在AI生成的答案中占据更有利的位置。
                                    <br/>&nbsp;&nbsp;&nbsp;&nbsp;这有助于提升品牌在用户心目中的权威性和可信度，增强用户对品牌的信任。</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6 col-sm-12">
                        <div class="sasly-info-box style-one mb-30" data-aos="fade-up" data-aos-duration="1800">
                            <div class="content">
                                <div class="number">02</div>
                                <h4 class="title">抢占AI流量入口</h4>
                                <p>&nbsp;&nbsp;&nbsp;&nbsp;Gartner的研究，传统搜索引擎流量预计在2024-2026年间下降<b class="highlight-number">25%↓</b>，而同期AI驱动的内容交互量将增长<b class="highlight-number-d">300%↑</b><br/>
                                    &nbsp;&nbsp;&nbsp;&nbsp;这意味着，未来越来越多的用户将通过AI平台获取信息，企业若不重视GEO，将失去大量潜在流量和用户。</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6 col-sm-12">
                        <div class="sasly-info-box style-one mb-30" data-aos="fade-up" data-aos-duration="2100">
                            <div class="content">
                                <div class="number">03</div>
                                <h4 class="title">营销获客降本增效</h4>
                                <p style="line-height: normal;"><b>精准触达：</b><br/>
                                    AI主动推荐品牌内容，减少无效曝光，获客成本直降<b class="highlight-number">60%-70%↓</b>；<br/>
                                    <b>零点击转化：</b><br/>
                                    用户直接获取品牌权威答案，提升信任度与转化率，流量质量提升<b class="highlight-number-d">200%↑</b>；<br/>
                                    <b>动态优化：</b><br/>
                                    实时适配用户需求与算法变化，降低长期投放依赖，ROI提升<b class="highlight-number-d">150%↑</b>。</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="company-ss pt-70 pb-70" data-aos="fade-up" data-aos-duration="1400">
        <div class="container-fluid">
            <div class="comapny-slider">
                <div class="company-item">
                    <div class="company-img">
                        <img src="/assets/picture/client-1.png" alt="Company Thumbnail">
                    </div>
                </div>
                <div class="company-item">
                    <div class="company-img">
                        <img src="/assets/picture/client-2.png" alt="Company Thumbnail">
                    </div>
                </div>
                <div class="company-item">
                    <div class="company-img">
                        <img src="/assets/images/comapny/client-3.png" alt="Company Thumbnail">
                    </div>
                </div>
                <div class="company-item">
                    <div class="company-img">
                        <img src="/assets/picture/client-4.png" alt="Company Thumbnail">
                    </div>
                </div>
                <div class="company-item">
                    <div class="company-img">
                        <img src="/assets/picture/client-5.png" alt="Company Thumbnail">
                    </div>
                </div>
                <div class="company-item">
                    <div class="company-img">
                        <img src="/assets/picture/client-6.png" alt="Company Thumbnail">
                    </div>
                </div>
                <div class="company-item">
                    <div class="company-img">
                        <img src="/assets/picture/client-7.png" alt="Company Thumbnail">
                    </div>
                </div>
                <div class="company-item">
                    <div class="company-img">
                        <img src="/assets/picture/client-8.png" alt="Company Thumbnail">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <CTASection />
</BaseLayout>
