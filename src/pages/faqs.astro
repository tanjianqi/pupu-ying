---
// 页面: FAQs（常见问题）
// 职责: hero横幅 + 横幅大图 + 分类Tab切换 + 3类共 30 条 FAQ 手风琴 + 跑马灯 + CTA
// 依赖: BaseLayout, CTASection
// 来源: 从原 faqs.html 迁移 main 内容，路径/内链按规则替换
// 注: FAQs 页不在主菜单高亮，activeNav 留空
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';

// FAQ 数据抽取：3 个分类，每类 10 条。原 HTML 中第一项展开，其余 collapse
const categories = [
  {
    id: 'cat1',
    label: '基础认知 & 品牌定位优化',
    active: true,
    accordionId: 'accordionOne',
    items: [
      { q: '什么是 GEO 品牌优化？', a: 'GEO 即地域维度品牌优化，指结合不同国家、地区、时区、地域消费习惯、法规、文化差异，针对性调整品牌形象、品牌话术、产品定位、视觉风格，让品牌适配目标地域市场，提升地域用户认同感、品牌本地化辨识度，降低地域运营壁垒。' },
      { q: 'GEO 品牌优化和普通品牌优化的核心区别是什么？', a: '普通品牌优化侧重全域统一品牌形象、口碑、视觉；GEO 品牌优化以地域为核心拆分运营，允许同一品牌在不同区域做差异化包装，重点适配地域文化、消费偏好、语言、政策、消费水平，兼顾品牌统一性 + 本地化差异化。' },
      { q: '品牌为什么一定要做 GEO 地域优化？', a: '不同地域用户审美、需求、消费能力、购物习惯差异极大，不做 GEO 优化易出现品牌水土不服，比如审美不符、卖点错位、文案违和；做好 GEO 优化可提升地域信任度、减少地域差评、提高本地化流量权重、降低合规风险，快速切入细分海外市场。' },
      { q: 'GEO 品牌定位该如何划分目标区域？', a: '优先按大洲划分基础分区（欧美、东南亚、中东、拉美），再结合消费水平、宗教文化、法规细分子区域；例如欧美高端简约定位、东南亚高性价比刚需定位、中东轻奢保守风格定位，拒绝一套定位覆盖全区域。' },
      { q: '多区域运营，如何平衡品牌统一和 GEO 本地化差异？', a: '核心品牌 LOGO、品牌核心价值观、品牌 slogan 主干保持统一；视觉色调、宣传文案、产品卖点、活动玩法、服务政策、节日营销做 GEO 差异化调整，既保证品牌整体辨识度，又贴合当地用户认知。' },
      { q: 'GEO 品牌优化需要重点调研地域哪些基础信息？', a: '需调研 6 项核心内容：当地宗教文化禁忌、主流审美风格、消费水平与客单价、热门消费趋势、电商购物习惯、当地法律法规 & 广告限制，所有品牌包装优化都基于地域调研数据落地。' },
      { q: '小众地域市场，有必要投入 GEO 品牌精细化优化吗？', a: '有必要。小众地域竞争小，轻量化 GEO 优化（仅调整文案、基础视觉、合规话术）即可快速建立差异化品牌优势；无需大成本改造，极简本地化调整就能甩开同质化竞品，提升区域复购。' },
      { q: 'GEO 品牌视觉优化主要包含哪些调整内容？', a: '包含地域适配图片风格、模特人种选择、色彩搭配、场景海报、图标设计、包装设计；例如欧美偏爱极简冷色调、东南亚偏爱鲜艳暖色调、中东规避暴露画面、欧美多用本土模特。' },
      { q: '品牌 GEO 定位模糊，会造成哪些负面影响？', a: '会导致卖点无法打动本地用户、品牌显得廉价且不专业、地域流量精准度低、广告投放转化率差、易触碰当地文化禁忌引发口碑危机、平台地域流量权重下降，长期难以沉淀区域品牌口碑。' },
      { q: '新品牌起步，优先优化哪些区域的 GEO 品牌内容？', a: '优先选择核心盈利市场 + 流量主力市场，先优化 1-2 个重点区域打磨本地化模型，形成标准化 GEO 优化模板后，再批量复制到其他小众区域，降低试错成本，提升优化效率。' }
    ]
  },
  {
    id: 'cat2',
    label: '内容 & 搜索 SEO-GEO 优化',
    active: false,
    accordionId: 'accordionTwo',
    items: [
      { q: 'GEO SEO 优化是什么，核心作用是什么？', a: 'GEO SEO 是地域化搜索引擎优化，针对不同地区搜索引擎、本地搜索习惯、地域关键词，优化网站 / 店铺文案、标题、关键词、落地页；核心作用是获取本地自然搜索流量，提升区域关键词排名，精准匹配地域用户搜索需求。' },
      { q: '如何布局不同地区的 GEO 核心关键词？', a: '1. 利用谷歌关键词规划师、本地搜索工具，挖掘各区域本土口语化关键词、方言词、地域热搜词；2. 同一产品，不同地区替换差异化卖点关键词；3. 区分通用词 + 地域长尾词，例如 “产品 + 国家 / 城市” 地域组合关键词布局。' },
      { q: '多国家站点，GEO 页面内容需要全部独立撰写吗？', a: '核心产品介绍、参数可通用，标题、描述、卖点文案、营销话术、售后说明、节日内容必须独立本地化撰写；禁止机器直译，采用本土母语人工润色，避免语法错误、用词违和影响搜索排名与用户体验。' },
      { q: 'GEO 地域文案优化有哪些禁忌和注意点？', a: '严格规避当地宗教、政治、文化敏感词；计量单位、货币符号、时间格式按地域调整（如欧美英寸 / 英尺、东南亚本土货币）；避免中式直译，贴合当地网购话术，精简冗余内容，提升页面阅读体验。' },
      { q: '独立站如何设置 GEO 地域落地页提升搜索流量？', a: '1. 按国家 / 地区搭建独立子页面、子域名或目录；2. 标注地域 Hreflang 标签，告诉搜索引擎页面归属地区；3. 落地页融入本地节日、地域需求、本地服务卖点；4. 绑定区域服务器，提升本地访问速度，助力 GEO 排名。' },
      { q: '社媒宣传内容怎么做 GEO 差异化优化？', a: '按区域划分社媒账号，欧美侧重干货、测评、极简种草；东南亚侧重短视频、性价比、社群福利；中东侧重高端质感、隐私保护；文案语言、话题标签、发布时间、热门话题全部贴合当地时区与热点。' },
      { q: '机器翻译的 GEO 内容，会影响 SEO 权重吗？', a: '会严重影响。机器翻译语句生硬、语法错误、用词偏差，不仅会降低用户停留时长、拉高跳出率，搜索引擎会判定内容低质、非本地化，直接降低 GEO 页面收录和关键词排名，长期影响站点整体权重。' },
      { q: '如何提升品牌在本地搜索的 GEO 曝光？', a: '完善本地商家信息、填写地域地址、时区、联系方式；发布本地资讯、区域活动、本地化测评内容；布局本地问答、论坛、社交平台地域种草内容；优化图片 ALT 标签、本地化标题描述，强化地域标签属性。' },
      { q: 'GEO 内容优化中，多语言版本该如何管理？', a: '统一内容框架，拆分多语言本地化团队；建立 GEO 内容素材库（地域海报、话术、活动文案）；定期更新各区域热点内容、季节内容、节日内容；定期排查低质翻译内容，统一整改，保障多区域内容质量。' },
      { q: '地域长尾关键词在 GEO 优化中为什么重要？', a: '地域长尾词竞争度低、搜索意图精准、转化更高，大多是精准刚需用户；布局大量区域长尾 GEO 关键词，可抢占细分搜索流量，避开大词激烈竞争，快速提升中小品牌在细分地域的搜索曝光。' }
    ]
  },
  {
    id: 'cat3',
    label: '店铺 & 运营转化优化',
    active: false,
    accordionId: 'accordionThree',
    items: [
      { q: '店铺 GEO 运营优化主要包含哪些模块？', a: '包含地域定价、物流方案、支付方式、售后政策、活动玩法、客服话术、商品详情、运费模板、退换货规则、平台地域标签设置，全链路贴合当地消费习惯，提升下单转化。' },
      { q: '不同区域如何做合理的 GEO 差异化定价？', a: '结合当地关税、物流成本、消费水平、竞品定价、汇率波动制定价格；高消费地区适当溢价，下沉市场、东南亚等区域走性价比定价；同时设置地域专属优惠券、满减，平衡价格差异，避免跨区域比价冲突。' },
      { q: '物流和配送如何进行 GEO 优化提升转化？', a: '按区域配置差异化物流渠道，欧美优先海外仓时效物流，东南亚选择本土专线，偏远地区明确配送时效与运费；商品详情页标注本地发货、时效、物流保障，降低用户下单顾虑，减少地域退款。' },
      { q: '支付方式 GEO 优化该怎么落地？', a: '调研各区域主流支付工具，欧美配置信用卡、PayPal；东南亚配置本土电子钱包；中东适配本地主流支付；关闭当地无法使用的支付渠道，减少付款失败、订单流失问题，提升付款成功率。' },
      { q: '客服话术与售后如何做 GEO 本地化优化？', a: '配备对应区域语种客服，适配当地时差排班；售后规则贴合当地消费法规，比如欧美完善退换货政策，简化售后流程；客服沟通话术贴合本地语言习惯，避免生硬官方话术，提升用户服务体验。' },
      { q: '区域节日营销，属于 GEO 品牌优化范畴吗？', a: '属于核心优化项。各区域节日、庆典、购物节完全不同，例如欧美黑五、东南亚泼水节、中东开斋节；针对性做 GEO 节日活动、限定套餐、节日视觉、专属优惠，可快速拉动区域销量与品牌好感度。' },
      { q: '如何利用 GEO 优化降低地域退货率和差评率？', a: '本地化优化商品详情，标注地域适配参数（电压、尺寸、规格）；明确当地售后、物流、使用注意事项；展示本地用户评价、真实买家秀；规避地域适配性问题，从源头减少误解类退货与差评。' },
      { q: '平台店铺的 GEO 地域标签需要手动优化吗？', a: '需要。手动精准填写主营市场、销售区域、发货地、地域服务标签；精准绑定目标国家 / 地区，平台会根据 GEO 标签匹配地域流量，避免流量错乱，提升流量精准度，减少无效访客。' },
      { q: '跨区域限购、区域限售，是 GEO 优化的手段吗？', a: '是。针对合规限制、物流盲区、关税高危区域，设置 GEO 限售、限购、区域限购提醒；既能规避合规风险，又能集中资源运营核心优质市场，降低运营损耗，保障品牌区域稳定运营。' },
      { q: '怎么判断自身 GEO 品牌优化效果是否达标？', a: '参考 6 项核心数据：区域自然流量占比、地域访客转化率、区域复购率、地域差评率、本地关键词排名、区域广告投产比；数据稳步提升代表优化有效，若流量散乱、转化低迷，则需要重新调整 GEO 本地化策略。' }
    ]
  }
];
---
<BaseLayout activeNav="" title="FAQs - 扑扑鹰" bodyClass="business-home">

    <section class="page-hero-ss">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="page-content text-center">
                        <h1 class="page-title">FAQs</h1>
                        <ul class="breadcrumb-link">
                            <li><a href="/">扑扑鹰GEO</a></li>
                            <li class="active">FAQs</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="page-banner-ss pb-130">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="sasly-image-box">
                        <img src="/assets/picture/pricing1.jpg" alt="Faq Image">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="faqs-page-ss pb-80">
        <div class="container">
            <div class="row">
                <div class="col-lg-5">
                    <div class="section-content-box mb-50">
                        <div class="section-title">
                            <span class="sub-heading">FAQs</span>
                            <h2 class="text-anm">FAQ问答集锦专区</h2>
                        </div>
                    </div>
                    <div class="sasly-nav-tabs" data-aos="fade-up" data-aos-duration="1200">
                        <ul class="nav nav-tabs">
                            {categories.map((cat, idx) => (
                                <li>
                                    <button class={`nav-link${cat.active ? ' active' : ''}`} data-bs-toggle="tab" data-bs-target={`#${cat.id}`}>{cat.label}</button>
                                </li>
                            ))}
                        </ul>
                    </div>
                </div>
                <div class="col-lg-7">
                    <div class="tab-content mb-40" data-aos="fade-up" data-aos-duration="1400">
                        {categories.map((cat) => (
                            <div class={`tab-pane fade${cat.active ? ' show active' : ''}`} id={cat.id}>
                                <div class="accordion" id={cat.accordionId}>
                                    {cat.items.map((item, i) => (
                                        <div class="accordion-item mb-10">
                                            <div class="accordion-header">
                                                <h6 class="accordion-title" data-bs-toggle="collapse" data-bs-target={`#${cat.accordionId}-collapse-${i + 1}`} aria-expanded={i === 0 ? 'true' : 'false'}>
                                                    <span class="sn">{String(i + 1).padStart(2, '0')}.</span> {item.q}
                                                </h6>
                                            </div>
                                            <div id={`${cat.accordionId}-collapse-${i + 1}`} class={`accordion-collapse collapse${i === 0 ? ' show' : ''}`} data-bs-parent={`#${cat.accordionId}`}>
                                                <div class="accordion-content">
                                                    <p>{item.a}</p>
                                                </div>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="animated-big-text pb-75">
        <div class="headline-wrap style-two">
            <span class="marquee-wrap">
                <span class="marquee-inner left">
                    <span class="marquee-item"><b>  扑扑鹰·专业领先的GEO优化服务商。</b></span>
                    <span class="marquee-item"><b>让你的品牌，成为AI的答案</b></span>
                </span>
                <span class="marquee-inner left">
                    <span class="marquee-item"><b>  扑扑鹰·专业领先的GEO优化服务商。</b></span>
                    <span class="marquee-item"><b>让你的品牌，成为AI的答案</b></span>
                </span>
            </span>
        </div>
    </section>

    <CTASection />
</BaseLayout>
